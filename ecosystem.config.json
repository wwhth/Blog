{
  "apps": [{
    "name": "Blog",
    "script": "./server.js",
    "args": "",
    "interpreter": "node",
    "env": {
      "NODE_ENV": "production",
      "NEXT_TELEMETRY_DISABLED": "1"
    },
    "instances": 2,      
    "exec_mode": "fork",
    "error_file": "/app/logs/err.log",  
    "out_file": "/app/logs/out.log",
    "log_date_format": "YYYY-MM-DD HH:mm Z",
    "min_uptime": "120s",
    "max_restarts": 8,
    "autorestart": true,  
    "watch": false,
    "max_memory_restart": "800M" 
  }]
}
